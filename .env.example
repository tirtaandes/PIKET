# Firebase Web App Configuration (Salin ke file .env dan isi dari Firebase Console)
# JANGAN PERNAH menyimpan credential Admin SDK / Service Account di frontend!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-southeast2

# Opsional: set true hanya untuk pengembangan lokal menggunakan Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=false
